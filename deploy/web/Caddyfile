# DOMAIN=search.example.com gets an automatic Let's Encrypt certificate.
# DOMAIN=:80 serves plain HTTP (local testing, or behind another proxy).
{$DOMAIN::80} {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:8000 {
			transport http {
				read_timeout 130s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
