# Copy to .env and fill in. Never commit .env or secrets/.

# --- Public address ---------------------------------------------------------
# A domain pointed at this server (A record) → automatic HTTPS.
# Use :80 for plain HTTP testing by IP.
DOMAIN=search.example.com
APP_TITLE=OpenStreetMap Search

# --- Database ---------------------------------------------------------------
PG_DB=osm
PG_USER=osm
PG_PASSWORD=change-me-long-random
# Tune to the server: ~25% / ~50% of RAM
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=4GB

# --- Map data ---------------------------------------------------------------
# Default: all six GCC states (UAE, KSA, Qatar, Bahrain, Kuwait, Oman).
OSM_EXTRACT_URL=https://download.geofabrik.de/asia/gcc-states-latest.osm.pbf
# Optional clip, minlon,minlat,maxlon,maxlat. UAE only:
# OSM_BBOX=51.5,22.6,56.4,26.1
OSM2PGSQL_CACHE_MB=2000
OSM2PGSQL_PROCS=4

# --- Map start position -----------------------------------------------------
DEFAULT_LAT=25.2048
DEFAULT_LNG=55.2708
DEFAULT_ZOOM=11

# --- Access control & logging -------------------------------------------------
# true: every search needs a signed-in Firebase user (secrets/service_account.json required)
AUTH_REQUIRED=true
# Who may search. Emails and/or @domains. Empty = any signed-in account (anyone with a Google login!)
ALLOWED_EMAILS=
# true: every search (user, area, filters, results) is written to Firestore "searches"
LOG_SEARCHES=true
CORS_ORIGINS=*
MAX_AREA_KM2=4000000
MAX_RESULTS=100

# --- Mapbox (place-name search box + satellite layer) --------------------------
MAPBOX_TOKEN=

# --- Firebase web config (Project settings → General → Your apps → Web app) ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
